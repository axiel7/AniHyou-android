<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector
            android:name="home_enter"
            android:width="24dp"
            android:height="24dp"
            android:viewportWidth="960"
            android:viewportHeight="960">
            <group
                android:name="main_parent"
                android:pivotX="480"
                android:pivotY="480">
                <group
                    android:name="home_group"
                    android:pivotX="480"
                    android:pivotY="480">
                    <path
                        android:name="home_path"
                        android:fillColor="#000000"
                        android:pathData="M240,760L360,760L360,520L600,520L600,760L720,760L720,400L480,220L240,400L240,760ZM240,840Q207,840 183.5,816.5Q160,793 160,760L160,400Q160,381 168.5,364Q177,347 192,336L432,156Q443,148 455,144Q467,140 480,140Q493,140 505,144Q517,148 528,156L768,336Q783,347 791.5,364Q800,381 800,400L800,760Q800,793 776.5,816.5Q753,840 720,840L520,840L520,600L440,600L440,840L240,840ZM480,490L480,490L480,490L480,490L480,490L480,490L480,490L480,490L480,490L480,490Z" />
                </group>
            </group>
        </vector>
    </aapt:attr>

    <!-- Path morphing from outlined to filled -->
    <target android:name="home_path">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="300"
                android:interpolator="@android:interpolator/fast_out_slow_in"
                android:propertyName="pathData"
                android:valueFrom="M240,760L360,760L360,520L600,520L600,760L720,760L720,400L480,220L240,400L240,760ZM240,840Q207,840 183.5,816.5Q160,793 160,760L160,400Q160,381 168.5,364Q177,347 192,336L432,156Q443,148 455,144Q467,140 480,140Q493,140 505,144Q517,148 528,156L768,336Q783,347 791.5,364Q800,381 800,400L800,760Q800,793 776.5,816.5Q753,840 720,840L520,840L520,600L440,600L440,840L240,840ZM480,490L480,490L480,490L480,490L480,490L480,490L480,490L480,490L480,490L480,490Z"
                android:valueTo="M480,490L480,490L480,490L480,490L480,490L480,490L480,490L480,490L480,490L480,490ZM240,840Q207,840 183.5,816.5Q160,793 160,760L160,400Q160,381 168.5,364Q177,347 192,336L432,156Q443,148 455,144Q467,140 480,140Q493,140 505,144Q517,148 528,156L768,336Q783,347 791.5,364Q800,381 800,400L800,760Q800,793 776.5,816.5Q753,840 720,840L560,840L560,560L400,560L400,840L240,840ZM480,490L480,490L480,490L480,490L480,490L480,490L480,490L480,490L480,490L480,490Z"
                android:valueType="pathType" />
        </aapt:attr>
    </target>

    <!-- Bounce / Scale effect when selected -->
    <target android:name="home_group">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator
                    android:duration="150"
                    android:interpolator="@android:interpolator/fast_out_slow_in"
                    android:propertyName="scaleX"
                    android:valueFrom="1.0"
                    android:valueTo="0.85"
                    android:valueType="floatType" />
                <objectAnimator
                    android:duration="150"
                    android:interpolator="@android:anim/decelerate_interpolator"
                    android:propertyName="scaleX"
                    android:startOffset="150"
                    android:valueFrom="0.85"
                    android:valueTo="1.0"
                    android:valueType="floatType" />
                <objectAnimator
                    android:duration="150"
                    android:interpolator="@android:interpolator/fast_out_slow_in"
                    android:propertyName="scaleY"
                    android:valueFrom="1.0"
                    android:valueTo="0.85"
                    android:valueType="floatType" />
                <objectAnimator
                    android:duration="150"
                    android:interpolator="@android:anim/decelerate_interpolator"
                    android:propertyName="scaleY"
                    android:startOffset="150"
                    android:valueFrom="0.85"
                    android:valueTo="1.0"
                    android:valueType="floatType" />
            </set>
        </aapt:attr>
    </target>
</animated-vector>